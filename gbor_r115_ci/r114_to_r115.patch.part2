+        }
+        if(FreeGamesRemaining<=0){
+            FreeGamesRemaining=0; FreeGamesActive=false; FreeGamesEnding=true; Win=LockFeatureWin+FreeFeatureWin;
+            Log("FREEGAMES END played="+FreeGamesPlayed+" win="+Win);
+        } else Log("FREEGAMES SPIN played="+FreeGamesPlayed+" remaining="+FreeGamesRemaining);
+    }
+    static int CountDiamonds(){ int n=0; for(int i=0;i<15;i++) if(DiamondValues[i]>=0 || DiamondValues[i]==10010 || DiamondValues[i]==10025) n++; return n; }
+    static string DiamondValuesRecord(){ return "dv:"+string.Join(";",DiamondValues); }
+    static string DiamondLinkRecord(bool init){
