+        if(forceRetrigger){
+            // Three Golden Books centered on the first three reels for deterministic validation.
+            Stops[0]=9; Stops[1]=9; Stops[2]=9; Stops[3]=5; Stops[4]=5;
+        } else if(DeterministicFeatureTest && FreeGamesPlayed==1){
+            // K is the selected expanding symbol; these stops place K on reels 1/3/5.
+            Stops[0]=5; Stops[1]=0; Stops[2]=5; Stops[3]=1; Stops[4]=5;
+            Log("FREEGAMES EXPANDING symbol="+FreeExpandingSymbol+" stops="+string.Join(",",Stops));
+        } else if(DeterministicFeatureTest){
+            // Stable non-Book stops so the validation run ends predictably.
+            for(int i=0;i<5;i++) Stops[i]=4;
+        } else {
+            lock(LocalRandom){ for(int i=0;i<5;i++) Stops[i]=LocalRandom.Next(160); }
+        }
+        int books=VisibleGoldenBooks();
+        if(books>=3){
+            FreeGamesTotal += 10; FreeGamesRemaining += 10;
