+        return "x,0,"+string.Join(",",parts.ToArray());
+    }
+    static string FreeGamesStateRecord(){
+        return "f,"+FreeGamesTotal+","+FreeGamesPlayed+",1,1,1,"+FreeFeatureWin+","+FreeFeatureWin+","+FreeFeatureWin+",0,0";
+    }
+    static void AdvanceFreeGame(){
+        if(!FreeGamesActive || FreeGamesRemaining<=0) return;
