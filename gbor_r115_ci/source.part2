dation.
            Stops[0]=9; Stops[1]=9; Stops[2]=9; Stops[3]=5; Stops[4]=5;
        } else if(DeterministicFeatureTest && FreeGamesPlayed==1){
            // K is the selected expanding symbol; these stops place K on reels 1/3/5.
            Stops[0]=5; Stops[1]=0; Stops[2]=5; Stops[3]=1; Stops[4]=5;
            Log("FREEGAMES EXPANDING symbol="+FreeExpandingSymbol+" stops="+string.Join(",",Stops));
        } else if(DeterministicFeatureTest){
            // Stable non-Book stops so the validation run ends predictably.
            for(int i=0;i<5;i++) Stops[i]=4;
        } else {
            lock(LocalRandom){ for(int i=0;i<5;i++) Stops[i]=LocalRandom.Next(160); }
        }
        int books=VisibleGoldenBooks();
        if(books>=3){
            FreeGamesTotal += 10; FreeGamesRemaining += 10;
            Log("FREEGAMES RETRIGGER books="+books+" +10 total="+FreeGamesTotal+" remaining="+FreeGamesRemaining);
        }
        if(FreeGamesRemaining<=0){
            FreeGamesRemaining=0; FreeGamesActive=false; FreeGamesEnding=true; Win=LockFeatureWin+FreeFeatureWin;
            Log("FREEGAMES END played="+FreeGamesPlayed+" win="+Win);
        } else Log("FREEGAMES SPIN played="+FreeGamesPlayed+" remaining="+FreeGamesRemaining);
    }
    static int CountDiamonds(){ int n=0; for(int i=0;i<15;i++) if(DiamondValues[i]>=0 || DiamondValues[i]==10010 || DiamondValues[i]==10025) n++; return n; }
    static string DiamondValuesRecord(){ return "dv:"+string.Join(";",DiamondValues); }
    static string DiamondLinkRecord(bool init){
        var parts=new List<string>();
        for(int i=0;i<15;i++) parts.Add(DiamondStops[i]+":"+DiamondValues[i]);
        parts.Add(LockSpinsLeft.ToString());
        if(init) parts.Add("o");
        return "dl:"+string.Join(";",parts.ToArray());
    }
    static void BeginForcedLockSpin(){
        ClearLockSpin(); ClearFreeGames(); LockSpinActive=true; LockSpinInitVisual=true; LockSpinsLeft=3;
        int[] cells=new int[]{0,1,5,6,10,11};
        int[] vals=ForceFreeGamesAwardNext
            ? new int[]{10010,1,1,1,1,1}
            : new int[]{1,2,3,10,20,1};
        ForceFreeGamesAwardNext=false;
        for(int i=0;i<cells.Length;i++){
            DiamondValues[cells[i]]=vals[i]; DiamondStops[cells[i]]=(Spin*7+cells[i]*3)%160;
            if(vals[i]>=0 && vals[i]<10000) LockFeatureWin += vals[i]*100;
        }
        Log("LOCKSPIN START coins=6 spins=3 featureWin="+LockFeatureWin+" freeGames="+CountAwardedFreeGames());
    }
    static bool AddOneLockSpinCoin(){
        for(int i=0;i<15;i++) if(DiamondValues[i]<0){
            int[] values=new int[]{1,2,3,10,20};
            int value=values[(LockSpinRound+i)%values.Length];
            DiamondValues[i]=value; DiamondStops[i]=(Spin*11+LockSpinRound*17+i*5)%160;
            LockFeatureWin += value*100;
            Log("LOCKSPIN NEWCOIN cell="+i+" value="+value);
            return true;
        }
        return false;
    }
    static void AdvanceLockSpin(){
        if(!LockSpinActive) return;
        LockSpinRound++;
        bool add=ForceLockSpinCoinNext;
        ForceLockSpinCoinNext=false;
        // Local default: occasional Coin only. Deterministic validation disables random additions.
        if(!add && !DeterministicFeatureTest){ lock(LocalRandom){ add=LocalRandom.Next(100)<22; } }
        if(add && AddOneLockSpinCoin()) LockSpinsLeft=3;
        else LockSpinsLeft--;
        if(CountDiamonds()>=15){ LockFeatureWin += 100000; LockSpinsLeft=0; }
        if(LockSpinsLeft<=0){
            LockSpinsLeft=0; LockSpinActive=false;
            int awardedFreeGames=CountAwardedFreeGames();
            if(awardedFreeGames>0){
                LockSpinEnding=false; BeginFreeGames(awardedFreeGames);
                Log("LOCKSPIN -> FREEGAMES awarded="+awardedFreeGames+" carryWin="+LockFeatureWin);
            } else {
                LockSpinEnding=true; Win=LockFeatureWin;
                Log("LOCKSPIN END coins="+CountDiamonds()+" win="+Win);
            }
        } else Log("LOCKSPIN RESPIN left="+LockSpinsLeft+" coins="+CountDiamonds());
    }
    static void AddCashConnectionState(List<string> r){
        if(LockSpinActive || LockSpinEnding){
            string dl=DiamondLinkRecord(LockSpinInitVisual);
            r.Add("x,0,"+DiamondValuesRecord()+","+dl);
            if(LockSpinActive) r.Add("v,"+dl+",0");
            LockSpinInitVisual=false;
        } else if(FreeGamesActive || FreeGamesEnding){
            r.Add(FreeGamesPluginRecord());
        } else r.Add("x,0,"+InactiveDiamondValues());
    }
